{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateOS Company Research",
  "type": "object",
  "required": ["company", "thesis"],
  "properties": {
    "company": {"type": "string"},
    "thesis": {"type": "string"},
    "products": {"type": "array", "items": {"type": "string"}},
    "technical_layers": {"type": "array", "items": {"type": "string"}},
    "recent_innovations": {"type": "array", "items": {"type": "string"}},
    "durable_moat_candidates": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "role_relevance": {"type": ["string", "null"]},
    "evidence_quality": {"enum": ["high", "medium", "low"]}
  },
  "additionalProperties": true
}
